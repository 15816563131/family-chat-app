{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacks": {
      "image": "python_3.12",
      "install": [
        "pip install -r requirements.txt"
      ]
    }
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "OnFailure",
    "restartPolicyMaxRetries": 10,
    "startCommand": "python app.py"
  }
}
